# PostgreSQL
POSTGRES_USER=fincore
POSTGRES_PASSWORD=fincore
POSTGRES_DB=fincore
POSTGRES_PORT=5434
DATABASE_URL=postgres://fincore:fincore@localhost:5434/fincore?sslmode=disable

# Dragonfly (Redis-compatible)
DRAGONFLY_PASSWORD=fincore
DRAGONFLY_PORT=6379
DRAGONFLY_ADDR=localhost:6379

# API
HTTP_PORT=8080

# Payment provider: sandbox | razorpay (both are always registered; this picks the default)
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# You choose this value; paste the same string into Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# Admin API bearer token (min 32 chars): openssl rand -hex 24
ADMIN_API_TOKEN=
# Optional: send traces to Jaeger (docker compose --profile observability)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
RATE_LIMIT_PER_MINUTE=600
PAYMENT_CHECK_AFTER=2m
PAYMENT_EXPIRE_AFTER=30m

# test (default) or live. Live needs its own DATABASE_URL, rzp_live_ keys,
# RAZORPAY_WEBHOOK_SECRET and ADMIN_API_TOKEN; sandbox features are disabled.
FINCORE_MODE=test
