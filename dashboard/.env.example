# All values are server-side only; never prefix with NEXT_PUBLIC_.

# Test mode API (required). FINCORE_API_URL / ADMIN_API_TOKEN also work.
FINCORE_TEST_API_URL=http://localhost:8080
FINCORE_TEST_ADMIN_TOKEN=

# Live mode API (optional). A separate FinCore deployment started with
# FINCORE_MODE=live, its own database and rzp_live_ keys. Leave empty to keep
# the Live switch disabled.
FINCORE_LIVE_API_URL=
FINCORE_LIVE_ADMIN_TOKEN=

# Operator accounts live in the FinCore API (invite-only). By default the
# test-mode API is used; point these at another deployment to override.
FINCORE_AUTH_API_URL=
FINCORE_AUTH_ADMIN_TOKEN=

# Signs session cookies: openssl rand -hex 32
SESSION_SECRET=
